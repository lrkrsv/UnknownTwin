# =============================================================================
# AI Campus — Local-only environment variables
# Copy to .env.local and adjust as needed. No third-party API keys required.
# =============================================================================

# Signed session cookie secret (min 32 characters — change in production)
JWT_SECRET="change-me-to-a-long-random-secret-at-least-32-chars"

# SQLite database file path (default: ./data/aicampus.db)
# DATABASE_PATH="./data/aicampus.db"

# Local LLM backend
# transformers = in-process via @huggingface/transformers (default, no extra apps)
# ollama       = call a local Ollama server for better quality
LLM_ENGINE="transformers"

# In-process LLM model (when LLM_ENGINE=transformers)
TRANSFORMERS_LLM_MODEL="onnx-community/Qwen3-0.6B-ONNX"
# TRANSFORMERS_LLM_DTYPE="q4"

# Ollama settings (only used when LLM_ENGINE=ollama)
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1:8b"

# RAG tuning
# Top cosine score below this → low confidence + mentor CTA (default 0.35)
RAG_CONFIDENCE_THRESHOLD="0.35"
RAG_TOP_K="5"

# Local file uploads directory (default: ./data/uploads)
# UPLOADS_DIR="./data/uploads"
