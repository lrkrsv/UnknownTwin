# =============================================================================
# AI Campus — Environment Variables
# Copy to .env.local and fill in your values.
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_UNIVERSITY_NAME="Your University"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Supabase (https://supabase.com/dashboard)
# Create a project, enable Email auth + Magic Link in Authentication > Providers
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Service role key — server-only, never expose to the client
# Used in later milestones for admin ingestion and background jobs
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# -----------------------------------------------------------------------------
# LLM — Anthropic Claude (Milestone 3+)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY="sk-ant-..."

# -----------------------------------------------------------------------------
# Embeddings — OpenAI text-embedding-3-small, 1536 dims (Milestone 2+)
# -----------------------------------------------------------------------------
OPENAI_API_KEY="sk-..."

# -----------------------------------------------------------------------------
# Notifications — pluggable escalation alerts (Milestone 4+)
# -----------------------------------------------------------------------------
RESEND_API_KEY="re_..."
NOTIFY_FROM_EMAIL="AI Campus <noreply@your-university.edu>"
MENTOR_NOTIFY_EMAIL="mentors@your-university.edu"

# Optional: Twilio WhatsApp (alternative to email)
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
# MENTOR_WHATSAPP_TO="whatsapp:+1234567890"

# -----------------------------------------------------------------------------
# Voice — ElevenLabs scaffold (Milestone 7+)
# -----------------------------------------------------------------------------
# ELEVENLABS_API_KEY=""
# NEXT_PUBLIC_ELEVENLABS_AGENT_ID=""

# -----------------------------------------------------------------------------
# RAG tuning (Milestone 2+)
# -----------------------------------------------------------------------------
CONFIDENCE_THRESHOLD="0.55"
RAG_TOP_K="6"
